# Copy this file to .env and fill in the values. Never commit .env.
# Every setting is read with the FLEETKEEPER_ prefix.

FLEETKEEPER_DEBUG=true

# A plain postgresql:// URL is fine; the psycopg driver is selected automatically.
# Use a direct connection rather than a pooled one: transaction-mode poolers such as
# PgBouncer interfere with the statements Alembic issues during a migration.
FLEETKEEPER_DATABASE_URL=postgresql://user:password@host/database?sslmode=require
